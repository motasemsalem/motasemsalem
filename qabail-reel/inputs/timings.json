{
 "audio_duration_sec": 252.37,
 "note": "Times in seconds from start of voice.mp3. Phrase times from pause detection aligned to script; tribe-name times approximate (±0.4s).",
 "phrases": [
  {
   "start": 0.0,
   "end": 2.13,
   "text": "أشهرُ قبيلةٍ في صعيدِ مصر..."
  },
  {
   "start": 2.53,
   "end": 4.01,
   "text": "ليست عربيةَ الأصل!"
  },
  {
   "start": 4.63,
   "end": 5.46,
   "text": "منفيّون..."
  },
  {
   "start": 5.93,
   "end": 6.78,
   "text": "ثم غُزاة..."
  },
  {
   "start": 7.27,
   "end": 8.01,
   "text": "ثم ملوك."
  },
  {
   "start": 8.75,
   "end": 11.25,
   "text": "هذه حكايةُ القبائلِ العربيةِ في مصر."
  },
  {
   "start": 8.75,
   "end": 11.25,
   "text": "ابقَ حتى النهاية..."
  },
  {
   "start": 11.9,
   "end": 13.88,
   "text": "لأنك ستعرفُ أين تعيشُ قبيلتُك اليوم."
  },
  {
   "start": 14.52,
   "end": 16.23,
   "text": "البدايةُ عامَ ستِّمئةٍ وأربعين."
  },
  {
   "start": 16.82,
   "end": 19.05,
   "text": "عمرو بنُ العاصِ يدخلُ مصر..."
  },
  {
   "start": 19.59,
   "end": 22.68,
   "text": "ومعه قبائلُ من اليمنِ والحجاز:"
  },
  {
   "start": 19.59,
   "end": 22.68,
   "text": "لَخْم، وجُذام، وبَلِيّ، وجُهَيْنة."
  },
  {
   "start": 23.25,
   "end": 24.33,
   "text": "جُهَيْنةُ تحديدًا..."
  },
  {
   "start": 24.71,
   "end": 28.17,
   "text": "تركَت اسمَها على مدينةٍ كاملةٍ في سوهاج، حتى اليوم."
  },
  {
   "start": 28.83,
   "end": 31.89,
   "text": "بعد قرنٍ تقريبًا، عامَ سبعِمئةٍ وسبعةٍ وعشرين..."
  },
  {
   "start": 32.28,
   "end": 37.06,
   "text": "آلافٌ من قبيلةِ قَيْس يصلونَ من الشام، ويستقرّونَ حولَ بلبيس..."
  },
  {
   "start": 37.53,
   "end": 41.25,
   "text": "لتصبحَ الشرقيةُ أولَ موطنٍ كبيرٍ للعربِ في الدلتا."
  },
  {
   "start": 41.83,
   "end": 42.53,
   "text": "وفي الجنوب..."
  },
  {
   "start": 42.89,
   "end": 47.24,
   "text": "كانت ربيعةُ تشقُّ طريقَها إلى أسوان، ومنها خرجَ بنو الكَنْز..."
  },
  {
   "start": 47.68,
   "end": 49.47,
   "text": "حُكّامُ أقصى جنوبِ مصر."
  },
  {
   "start": 50.07,
   "end": 51.57,
   "text": "ثم جاءت اللحظةُ الأخطر."
  },
  {
   "start": 52.14,
   "end": 53.91,
   "text": "الفاطميونَ يحكمونَ مصر..."
  },
  {
   "start": 54.48,
   "end": 60.71,
   "text": "وقبيلتانِ عربيتانِ كبيرتان، بنو هلالٍ وبنو سُلَيْم، تقفانِ مع أعدائِهم القرامطة."
  },
  {
   "start": 61.34,
   "end": 61.83,
   "text": "العقاب؟"
  },
  {
   "start": 62.39,
   "end": 63.34,
   "text": "النفيُ إلى الصعيد..."
  },
  {
   "start": 63.82,
   "end": 65.16,
   "text": "ومنعُهم من عبورِ النيل."
  },
  {
   "start": 63.82,
   "end": 65.16,
   "text": "وبعد عقود..."
  },
  {
   "start": 65.74,
   "end": 71.77,
   "text": "حين تمرّدَ حُكّامُ تونسَ على القاهرة، فتحَ الفاطميونَ البابَ لهؤلاءِ المنفيّين..."
  },
  {
   "start": 72.21,
   "end": 73.35,
   "text": "وأطلقوهم غربًا."
  },
  {
   "start": 73.8,
   "end": 75.76,
   "text": "عبرَ الهلاليّونَ الصحراءَ إلى المغرب..."
  },
  {
   "start": 76.3,
   "end": 78.44,
   "text": "لكنّ بطونًا منهم بقيَت في مصر."
  },
  {
   "start": 78.92,
   "end": 81.24,
   "text": "ومن هنا وُلِدَت السيرةُ الهلالية..."
  },
  {
   "start": 81.66,
   "end": 84.54,
   "text": "التي ما زالَ شعراءُ الصعيدِ يُنشِدونَها إلى اليوم."
  },
  {
   "start": 85.15,
   "end": 85.5,
   "text": "والآن..."
  },
  {
   "start": 86.05,
   "end": 88.59,
   "text": "هل تذكرُ القبيلةَ التي ليست عربيةَ الأصل؟"
  },
  {
   "start": 89.09,
   "end": 90.24,
   "text": "إنها هَوّارة."
  },
  {
   "start": 90.71,
   "end": 91.92,
   "text": "وصلَت مع الفاطميين..."
  },
  {
   "start": 92.46,
   "end": 96.12,
   "text": "أصلُها أمازيغيٌّ من المغرب، لكنها تعرّبَت تمامًا."
  },
  {
   "start": 96.62,
   "end": 101.36,
   "text": "نزلَت الصعيدَ أيامَ المماليك..."
  },
  {
   "start": 96.62,
   "end": 101.36,
   "text": "حتى صارت الحاكمَ الفعليَّ له لقرون."
  },
  {
   "start": 101.83,
   "end": 104.17,
   "text": "وأشهرُ رجالِها..."
  },
  {
   "start": 101.83,
   "end": 104.17,
   "text": "شيخُ العربِ همّام."
  },
  {
   "start": 104.7,
   "end": 109.38,
   "text": "وإلى جوارِها في الصعيد..."
  },
  {
   "start": 104.7,
   "end": 109.38,
   "text": "انتشرَت قبائلُ مثل عَرَك، وفَزارة، ومُحارِب."
  },
  {
   "start": 109.97,
   "end": 113.09,
   "text": "وفي العصرِ العثماني، نحوَ عامِ ألفٍ وستِّمئةٍ وسبعين..."
  },
  {
   "start": 113.48,
   "end": 115.48,
   "text": "جاءت آخرُ موجةٍ كبرى من الغرب:"
  },
  {
   "start": 116.0,
   "end": 119.78,
   "text": "قبائلُ أولادِ علي، من ليبيا، يرجعُ نسبُهم إلى بني سُلَيْم."
  },
  {
   "start": 120.28,
   "end": 124.84,
   "text": "واليوم..."
  },
  {
   "start": 120.28,
   "end": 124.84,
   "text": "يتجاوزونَ مليونَي نسمة، من السلّومِ حتى البحيرة."
  },
  {
   "start": 125.39,
   "end": 127.34,
   "text": "ألفٌ وأربعُمئةِ عامٍ من الهجرات..."
  },
  {
   "start": 128.02,
   "end": 129.66,
   "text": "فأين استقرَّت كلُّ هذه القبائل؟"
  },
  {
   "start": 130.28,
   "end": 131.95,
   "text": "تعالَ نتجوّلْ على خريطةِ مصر."
  },
  {
   "start": 132.44,
   "end": 134.1,
   "text": "نبدأُ من الشرق..."
  },
  {
   "start": 132.44,
   "end": 134.1,
   "text": "من سيناء."
  },
  {
   "start": 134.64,
   "end": 146.71,
   "text": "في الشمال، على ساحلِ العريش:"
  },
  {
   "start": 134.64,
   "end": 146.71,
   "text": "السَّواركة، والرُّمَيْلات، والتَّرابين، والبَياضِيّة، والأَخارِسة، والعَقايْلة، والدَّواغْرة، والعَيايْدة، والمَساعيد، وبَلِيّ."
  },
  {
   "start": 147.22,
   "end": 151.19,
   "text": "والتَّرابينُ تحديدًا..."
  },
  {
   "start": 147.22,
   "end": 151.19,
   "text": "من أكبرِ قبائلِ البدوِ في المنطقةِ كلِّها."
  },
  {
   "start": 151.73,
   "end": 153.04,
   "text": "ننزلُ إلى الوسطِ والجنوب:"
  },
  {
   "start": 153.61,
   "end": 162.44,
   "text": "التِّياها، والعَزازْمة، والأَحْيوات، والحُوَيْطات، والمُزَيْنة، والعُلَيْقات، والصَّوالحة، والقَرارْشة، وبني واصِل..."
  },
  {
   "start": 162.81,
   "end": 163.5,
   "text": "والجَبالِيّة..."
  },
  {
   "start": 163.9,
   "end": 165.43,
   "text": "الذين يعيشونَ حولَ جبلِ موسى."
  },
  {
   "start": 165.95,
   "end": 168.87,
   "text": "نعبرُ القناةَ إلى الشرقيةِ والإسماعيليةِ والدلتا:"
  },
  {
   "start": 169.39,
   "end": 178.84,
   "text": "الهَنادي، والطَّحاوِيّة، والعَزايْزة، والحُوَيْطات، والمَعازة، والعَيايْدة، والسَّماعْنة، والنُّفَيْعات، وجُهَيْنة، والتَّرابين."
  },
  {
   "start": 179.41,
   "end": 180.16,
   "text": "نتّجهُ غربًا..."
  },
  {
   "start": 180.51,
   "end": 182.16,
   "text": "إلى مطروحَ والصحراءِ الغربية:"
  },
  {
   "start": 182.61,
   "end": 189.22,
   "text": "أولادُ علي الأحمر، وأولادُ علي الأبيض، ومنهم القُنَيْشات، والعُشَيْبات، والسَّنَنة، والعَزايِم..."
  },
  {
   "start": 189.65,
   "end": 193.44,
   "text": "ومعهم الجُمَيْعات، والقَطْعان، والحَبُّون، والسَّناقْرة."
  },
  {
   "start": 193.98,
   "end": 194.94,
   "text": "ثم ننحدرُ جنوبًا..."
  },
  {
   "start": 195.34,
   "end": 198.64,
   "text": "إلى الفيومِ وبني سويفَ والمنيا:"
  },
  {
   "start": 199.02,
   "end": 207.6,
   "text": "البَراعْصة، والفَوايِد، والرِّماح، والجَوازي، والحَرابي، والقَذاذْفة، والعُبَيْدات، والتَّرْهونة، والسَّمالوس، والعَواقير، والفُرْجان، والمُحارِب."
  },
  {
   "start": 207.96,
   "end": 210.6,
   "text": "ونصلُ إلى قلبِ الصعيد:"
  },
  {
   "start": 211.18,
   "end": 223.62,
   "text": "هَوّارة، والأشراف، والجَعافِرة، وجُهَيْنة، وبَلِيّ، والعَمايِم، والعَتاوْلة، والأنصار، والمَشارْقة، والجَوازي، والتَّرْهونة."
  },
  {
   "start": 224.13,
   "end": 227.19,
   "text": "ونختمُ الرحلةَ عند البحرِ الأحمرِ والصحراءِ الشرقية:"
  },
  {
   "start": 227.75,
   "end": 232.32,
   "text": "العَبابدة، والرَّشايْدة، والمَعازة، والحُوَيْطات، وجُهَيْنة..."
  },
  {
   "start": 232.86,
   "end": 234.49,
   "text": "وإلى جوارِهم البِشارِيّة."
  },
  {
   "start": 235.0,
   "end": 236.44,
   "text": "ألفٌ وأربعُمئةِ عام..."
  },
  {
   "start": 237.16,
   "end": 239.42,
   "text": "وما زالت القبيلةُ في مصرَ حيّة."
  },
  {
   "start": 240.18,
   "end": 241.44,
   "text": "ليست نسبًا فقط..."
  },
  {
   "start": 241.98,
   "end": 246.6,
   "text": "بل كرمٌ، وعاداتٌ، ومجالسُ عُرفيةٌ تحفظُ السلام."
  },
  {
   "start": 247.32,
   "end": 247.87,
   "text": "والآن..."
  },
  {
   "start": 248.26,
   "end": 248.67,
   "text": "دورُك."
  },
  {
   "start": 249.31,
   "end": 250.53,
   "text": "من أيِّ قبيلةٍ أنت؟"
  },
  {
   "start": 249.31,
   "end": 250.53,
   "text": "وهل ذكرناها؟"
  },
  {
   "start": 251.16,
   "end": 252.37,
   "text": "اكتبها في التعليقات."
  }
 ],
